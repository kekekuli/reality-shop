# Copy to .env (gitignored) and adjust if needed — or just run
# `pnpm db:init` from the repo root, which sets this up automatically
# for a disposable local Postgres (scripts/db-init.mjs).
DATABASE_URL=postgresql://ecommerce_app:ecommerce_dev@localhost:5432/ecommerce

# main.ts falls back to 3000 if unset — but apps/web's API_URL and
# infra/traefik/dynamic.yml's api target both assume 7676. Keep this set.
PORT=7676
