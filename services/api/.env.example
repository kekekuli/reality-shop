# Copy to .env (gitignored). `pnpm db:init` from the repo root sets
# DATABASE_URL up for a disposable local Postgres (scripts/db-init.mjs);
# the rest is on you.
#
# Required — no defaults. src/env.ts refuses to start without them,
# deliberately: a defaulted secret is forgeable by anyone who has read
# the repo, and a defaulted URL quietly points at the wrong system.
DATABASE_URL=postgresql://ecommerce_app:ecommerce_dev@localhost:5432/ecommerce

# BullMQ delayed tasks + refresh-token storage. Started by
# `docker compose up redis -d`; db:init does not manage it.
REDIS_URL=redis://localhost:6379

# At least 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=

# Optional — src/env.ts defaults each of these. Shown for discoverability.
# apps/web's API_URL and infra/traefik/dynamic.yml both assume 7676.
# PORT=7676
# ACCESS_TOKEN_TTL=900        # seconds; 15 minutes
# REFRESH_TOKEN_TTL=2592000   # seconds; 30 days
