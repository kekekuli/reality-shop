# Copy to .env.local (gitignored) and adjust if needed.

# Server-only — read by gqlFetch (lib/graphql/client.ts) for SSR calls to
# the api service directly, bypassing Traefik/Dokploy's public routing
# on purpose (see DECISIONS.md ADR-020). Point this at the api service's
# own port, never at the same-origin proxy.
API_URL=http://localhost:7676

# This app's own public-facing address, used for metadataBase/canonical
# URLs (app/[locale]/layout.tsx). Once Traefik is fronting things (see
# compose.yaml), that's :8000, not the Next dev server's own :6767.
SITE_URL=http://localhost:8000

# Optional, machine-specific — only needed if you reach the dev server
# by something other than localhost (e.g. a Tailscale IP/hostname).
# Without it, Next's dev server silently drops requests whose Host
# header doesn't match what it expects, including the HMR WebSocket.
# Comma-separated if you need more than one.
# ALLOWED_DEV_ORIGINS=100.x.x.x
