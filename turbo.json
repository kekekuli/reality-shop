{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "codegen": {
      "inputs": [
        "app/**/*.{ts,tsx}",
        "lib/**/*.{ts,tsx}",
        "../../services/api/src/schema.gql"
      ],
      "outputs": ["lib/graphql/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {}
  }
}
